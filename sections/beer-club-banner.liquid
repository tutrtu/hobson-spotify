{% schema %}
{
  "name": "Beer Club Banner",
  "tag": "section",
  "class": "beer-club-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join The Hobsons Beer Club"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "JOIN NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "windmill_image",
      "label": "Windmill Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background Overlay Opacity",
      "default": 50
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#F9BF3B"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Beer Club Banner",
      "category": "Promotional"
    }
  ]
}
{% endschema %}

<style>
  .beer-club-container {
    position: relative;
    width: 100%;
    height: 400px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: white;
    overflow: hidden;
    background-size: cover;
    background-position: center;
  }

  .beer-club-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
  }

  .beer-club-content {
    position: relative;
    z-index: 10;
    text-align: center;
  }

  .beer-club-heading {
    font-family: 'Bayland-Regular';
    font-size: 48px;
    margin-bottom: 30px;
    text-align: center;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    color: white;
  }

  .beer-club-button {
    padding: 12px 30px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.3s;
    border: none;
  }

  .beer-club-button:hover {

    background-color: #02264a!important;
  }

  .windmill-image {
    position: absolute;
    right: 40px;
    bottom: 0;
    height: 250px;
    width: auto;
    z-index: 5;
  }

  @media screen and (max-width: 768px) {
    .beer-club-heading {
      font-size: 36px;
    }

    .windmill-image {
      height: 180px;
      right: 20px;
    }
  }
</style>

<div
  class="beer-club-container"
  style="background-image: url('{{ section.settings.background_image | img_url: 'master' }}');"
>
  <div
    class="beer-club-overlay"
    style="background-color: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
  ></div>

  <div class="beer-club-content">
    <h1 class="beer-club-heading">{{ section.settings.heading }}</h1>

    {% if section.settings.button_link != blank %}
      <a href="{{ section.settings.button_link }}">
        <button
          class="beer-club-button"
          style="background-color: {{ section.settings.button_color }}; color: {{ section.settings.button_text_color }};"
        >
          {{ section.settings.button_text }}
        </button>
      </a>
    {% endif %}
  </div>

  {% if section.settings.windmill_image != blank %}
    <img
      src="{{ section.settings.windmill_image | img_url: 'master' }}"
      alt="Windmill"
      class="windmill-image"
    >
  {% endif %}
</div>
