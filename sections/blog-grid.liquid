{% schema %}
{
  "name": "Hobsons Under The Hat",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Hobsons: Under The Hat"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Number of posts to show",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_featured",
      "label": "Show featured post",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hobsons Under The Hat",
      "category": "Custom Content"
    }
  ]
}
{% endschema %}

<style>
  .hobsons-section * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;

  }

  .hobsons-section {
    background-color: #f9f9f9;
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
  }

  .hobsons-header {
    text-align: center;
    margin-bottom: 30px;
  }

  .hobsons-header h2 {
    display: inline-block;
    background-color: #f9d240;
    padding: 5px 15px;
    font-size: 24px;
    text-transform: uppercase;
  }

  .hobsons-container {
    display: flex;
    gap: 20px;
  }

  .hobsons-main-content {
    flex: 3;
    min-width: 300px;
  }

  .hobsons-sidebar {
    flex: 2;
    min-width: 200px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hobsons-foodie-nights {
    background-color: white;
    border-radius: 5px;
    overflow: hidden;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    position: relative;
  }

  .hobsons-foodie-nights img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .hobsons-foodie-title {
    text-align: center;
    padding: 20px;
    color: #1e3a6e;
    text-transform: uppercase;
    font-weight: bold;
    font-size: 18px;
  }

  .hobsons-info-tag {
    position: absolute;
    bottom: 20%;
    left: 0;
    background-color: #f9d240;
    padding: 5px 10px;
    font-size: 12px;
  }

  .hobsons-article-item {
    display: flex;
    background-color: white;
    border-radius: 5px;
    overflow: hidden;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
  }

  .hobsons-article-image {
    flex: 0 0 100px;
    min-width: 100px;
  }

  .hobsons-article-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .hobsons-article-content {
    flex: 1;
    padding: 15px;
  }

  .hobsons-article-content h3 {
    color: #1e3a6e;
    margin-bottom: 10px;
    font-size: 16px;
  }

  .hobsons-article-content p {
    font-size: 12px;
    line-height: 1.4;
    color: #555;
  }

  .hobsons-button-row {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 20px;
  }

  .hobsons-button {
    display: inline-block;
    background-color: #f9d240;
    color: #333;
    padding: 10px 20px;
    text-decoration: none;
    text-transform: uppercase;
    font-weight: bold;
    font-size: 14px;
    border-radius: 3px;
  }

  @media (max-width: 768px) {
    .hobsons-container {
      flex-direction: column;
    }

    .hobsons-article-item {
      flex-direction: column;
    }

    .hobsons-article-image {
      flex: 0 0 auto;
      min-width: 100%;
      height: 200px;
    }
  }
</style>

<div class="hobsons-section">
  <header class="hobsons-header">
    <h2>{{ section.settings.heading }}</h2>
  </header>

  <div class="hobsons-container">
    {% if section.settings.show_featured %}
      <div class="hobsons-main-content">
        {% assign featured_article = blogs[section.settings.blog].articles | first %}
        {% if featured_article %}
          <div class="hobsons-foodie-nights">
            {% if featured_article.image %}
              <img
                src="{{ featured_article.image | img_url: '600x400', crop: 'center' }}"
                alt="{{ featured_article.title }}"
              >
            {% else %}
              <img src="{{ 'placeholder.jpg' | asset_url }}" alt="{{ featured_article.title }}">
            {% endif %}

            {% if featured_article.tags.size > 0 %}
              <div class="hobsons-info-tag">{{ featured_article.tags.first }}</div>
            {% endif %}

            <div class="hobsons-foodie-title">{{ featured_article.title }}</div>

            <a href="{{ featured_article.url }}" class="hobsons-button">Read More</a>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="hobsons-sidebar">
      {% assign sidebar_limit = section.settings.post_limit | minus: 1 %}
      {% if section.settings.show_featured == false %}
        {% assign sidebar_limit = section.settings.post_limit %}
      {% endif %}

      {% for article in blogs[section.settings.blog].articles limit: sidebar_limit offset: 1 %}
        <div class="hobsons-article-item">
          <div class="hobsons-article-image">
            {% if article.image %}
              <img
                src="{{ article.image | img_url: '100x100', crop: 'center' }}"
                alt="{{ article.title }}"
                height="100"
                width="100"
              >
            {% endif %}
          </div>
          <div class="hobsons-article-content">
            <h3>{{ article.title }}</h3>
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
            <a href="{{ article.url }}" class="hobsons-button">Read More</a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
